# Compose host port; optional. Native defaults are documented in README.md.
APP_PORT=8000
MAX_UPLOAD_BYTES=1073741824
MAX_EXPANDED_BYTES=2147483648
MAX_ARCHIVE_MEMBERS=25000
MAX_QUEUED_JOBS=4
JOB_TIMEOUT_SECONDS=600

# Total automatic upload/reconstruction worker deadline (seconds)
RECONSTRUCTION_TIMEOUT_SECONDS=3600
# auto selects available dense CUDA, otherwise an explicitly labelled sparse preview
RECONSTRUCTION_MODE=auto
## Optional native Windows CUDA executable (official COLMAP 4.2.1).
# COLMAP_EXECUTABLE=C:/tools/colmap/bin/colmap.exe
